<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_proconsult_tana_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                <div class="page">
                    

                    <div class="row mb-4">
                        <div class="col-6">
                            <h5 style="color: #1a365d; border-left: 3px solid #1a365d; padding-left: 8px; font-weight: bold;">Informations Client</h5>
                            <div class="ps-2">
                                <div class="fw-bold" t-field="doc.partner_id.x_categorie_client"/>
                                <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <h5 style="color: #1a365d; font-weight: bold;">Détails Prestation</h5>
                            <div class="pe-2">
                                <div><strong>Type : </strong><span t-field="doc.x_type_prestation"/></div>
                                <div><strong>Date de début : </strong><span t-field="doc.x_date_debut_prestation" t-options='{"widget": "date"}'/></div>
                                <div><strong>Date de fin : </strong><span t-field="doc.x_date_fin_prestation" t-options='{"widget": "date"}'/></div>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table table-striped mt-4">
                        <thead>
                            <tr style="background-color: #1a365d; color: white;">
                                <th class="text-start">Description</th>
                                <th class="text-end" style="width: 15%;">Quantité</th>
                                <th class="text-end" style="width: 20%;">Prix Unitaire</th>
                                <th class="text-end" style="width: 20%;">Total</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="doc.invoice_line_ids" t-as="line">
                                <tr>
                                    <td class="text-start"><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row justify-content-end" style="page-break-inside: avoid;">
                        <div class="col-4 text-end">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="text-muted"><strong>Sous-total :</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><strong>Taxes :</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_tax"/></td>
                                </tr>
                                <tr class="border-top" style="font-size: 11pt;">
                                    <td><strong style="color: #1a365d;">Montant Total :</strong></td>
                                    <td class="text-end"><strong style="color: #1a365d;"><span t-field="doc.amount_total"/></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="footer text-center mt-5 pt-4" style="border-top: 1px solid #e2e8f0; font-size: 8.5pt; color: #718096;">
                        <div>Mention Légale : NIF: 3000123456 | STAT: 45103 11 2024 0 00124 | RCS Tana</div>
                        <div>ProConsult Tana — Enceinte Expérimentale IA, Antananarivo, Madagascar</div>
                        <div>Contact : contact@proconsult-tana.mg | Tél : +261 34 00 000 00</div>
                    </div>

                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>