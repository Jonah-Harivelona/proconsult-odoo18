<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_proconsult_sale_report_pivot" model="ir.ui.view">
       <field name="name">proconsult.sale.report.pivot</field>
       <field name='model'>proconsult.sale.report</field>
        <field name="arch" type="xml">
            <pivot string="Analyse croisée ProConsult">
                <field name="user_id" type="row"/>
                <field name="x_type_prestation" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_proconsult_sale_report_graph" model="ir.ui.view">
       <field name="name">proconsult.sale.report.graph</field>
       <field name='model'>proconsult.sale.report</field>
        <field name="arch" type="xml">
            <graph string="Graphique ProConsult">
                <field name="date_order" />
                <field name="x_type_prestation"/>
                <field name="amount_total" />
            </graph>
        </field>
    </record>

    <record id="view_proconsult_sale_report_list" model="ir.ui.view">
        <field name="name">proconsult.sale.report.list</field>  
        <field name="model">proconsult.sale.report</field>
         <field name="arch" type="xml">
            <list string="Détail ProConsult">
                <field name="date_order"/>
                <field name="partner_id" string="Client"/>
                <field name="user_id" string="Commercial"/>
                <field name="x_type_prestation"/>
                <field name="amount_total" sum="Total" string="Montant"/>
            </list>
        </field>
    </record>

    <record id="action_proconsult_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="res_model">proconsult.sale.report</field>
        <field name="view_mode">list,graph,pivot</field>
    </record>


    <menuitem id="menu_proconsult_dashboard"
              name="Tableau de bord ProConsult"
              parent="sale.sale_menu_root"
              action="action_proconsult_dashboard"
              sequence="5"/>

</odoo>