<?xml version="1.0" encoding="utf-8"?>
<odoo>

      <record id="view_partner_form_proconsult" model="ir.ui.view">
        <field name="name">res.partner.form.proconsult</field>
        <field name='model'>res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <group name="proconsult" string="proconsult">
                    <field name="x_categorie_client"/>
                    <field name="x_secteur_activite"/>
                    <field name="x_commercial_referent"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
