<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_sale_order_form_proconsult" model="ir.ui.view">
        <field name="name">sale.order.form.proconsult</field>
        <field name='model'>sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']" position="after">
                <group name="proconsult" string="proconsult">
                    <field name="x_type_prestation"/>
                    <field name="x_date_debut_prestation"/>
                    <field name="x_date_fin_prestation"/>
                    <field name="x_contrat_cadre"/>
                </group>
            </xpath>
        </field>
    
    </record>
</odoo>
