<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_proconsult_relance_form" model="ir.ui.view">
        <field name="name">proconsult.relance.form</field>
        <field name="model">proconsult.relance</field>
        <field name="arch" type="xml">
            <form string="Relance Commerciale Personnalisée">
                <header>
                    <button name="action_envoyer_relance" string="Envoyer les relances" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_limite"/>
                        </group>
                    </group>
                    <group string="Sélection des Destinataires">
                        <field name="partner_ids" widget="many2many_tags" placeholder="Ajouter des clients..."/>
                    </group>
                    <group string="Message Complémentaire">
                        <field name="message_personnalise" placeholder="Saisissez le texte de votre relance ici..."/>
                    </group>
                </sheet>
                
                   
               
            </form>
        </field>
    </record>

    <record id="action_proconsult_relance_wizard" model="ir.actions.act_window">
        <field name="name">Relancer des clients</field>
        <field name="res_model">proconsult.relance</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_proconsult_relance_wizard"
              name="Relances Clients"
              parent="account.menu_finance_receivables"
              action="action_proconsult_relance_wizard"
              sequence="15"/>
</odoo>